{
  "schemaVersion": 1,
  "contract": "oma-maintainer-bot-control-plane-v1",
  "integration": "github-agentic-workflows-custom-engine",
  "pinPolicy": {
    "ghAwReference": "REQUIRED_IMMUTABLE_COMMIT_SHA",
    "omaMaintainerBotPolicyVersion": "maintainer-policy-v1",
    "omaMaintainerBotPromptVersion": "maintainer-prompts-v1"
  },
  "trigger": {
    "event": "issues.labeled",
    "requiredLabel": "agent-ready",
    "requiredAuthorizerPermission": "write"
  },
  "customEngine": {
    "command": "node",
    "args": ["packages/maintainer-bot/dist/cli.js", "run"],
    "modelEnvironmentAllowlist": ["DEEPSEEK_API_KEY"],
    "modelEnvironmentForbidden": [
      "GITHUB_TOKEN",
      "GH_TOKEN",
      "MAINTAINER_BOT_APP_TOKEN",
      "OMA_MAINTAINER_BOT_APP_PRIVATE_KEY",
      "GITHUB_APP_PRIVATE_KEY",
      "GITHUB_APP_INSTALLATION_TOKEN",
      "NPM_TOKEN",
      "NODE_AUTH_TOKEN"
    ]
  },
  "safeOutput": {
    "acceptedKind": "draft_pr",
    "requireEligibleForHostWrite": true,
    "hostMustRevalidate": [
      "issueRevision",
      "baseSha",
      "contextManifest",
      "policyPromptVersions",
      "runRecord",
      "proposalHash",
      "validationResults",
      "changedFiles",
      "worktreeHead",
      "worktreeChangedPaths",
      "worktreeAfterHashes",
      "validatedCandidateDiff",
      "reviewerAcceptance"
    ],
    "prohibitedActions": [
      "ready_for_review",
      "approve",
      "merge",
      "close_issue",
      "release",
      "publish"
    ]
  }
}
