{
  "name": "@open-multi-agent/maintainer-runtime",
  "version": "0.0.0",
  "private": true,
  "description": "Private credential-isolated coding and deterministic validation runtime for OMA Maintainer Bot.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "oma-maintainer-runtime": "dist/cli.js"
  },
  "scripts": {
    "prebuild": "npm run build -w @open-multi-agent/maintainer-bot",
    "build": "tsc",
    "prelint": "npm run build -w @open-multi-agent/maintainer-bot",
    "lint": "tsc --noEmit",
    "pretest": "npm run build -w @open-multi-agent/maintainer-bot",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@open-multi-agent/maintainer-bot": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
