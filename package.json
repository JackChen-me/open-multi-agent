{
  "name": "open-multi-agent",
  "version": "0.0.0",
  "private": true,
  "description": "Private workspace root for the open-multi-agent monorepo. The published package is @open-multi-agent/core in packages/core.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev -w @open-multi-agent/core",
    "pretest": "npm run test:example-catalog",
    "test": "npm run test --workspaces --if-present && npm run bench:ab:test",
    "test:example-catalog": "node --test scripts/example-catalog.test.mjs && node scripts/validate-example-catalog.mjs",
    "test:watch": "npm run test:watch -w @open-multi-agent/core",
    "test:coverage": "npm run test:coverage -w @open-multi-agent/core",
    "test:e2e": "npm run test:e2e -w @open-multi-agent/core",
    "bench:observability:ci": "node scripts/observability-benchmark-ci.mjs",
    "bench:ab": "tsx bench/src/run-bench.mts",
    "bench:ab:mock": "tsx bench/src/run-bench.mts --mock --label mock",
    "bench:ab:report": "tsx bench/src/report.mts",
    "bench:ab:test": "tsx --test bench/src/bench.test.mts",
    "test:eval-examples": "node scripts/eval-example-smoke.mjs",
    "test:observability-examples": "node scripts/observability-example-smoke.mjs",
    "test:observability-pack": "node scripts/observability-tarball-smoke.mjs",
    "test:scaffold": "npm run test:scaffold --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present && npm run lint:bench",
    "lint:bench": "tsc --noEmit -p bench/tsconfig.json"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-multi-agent/open-multi-agent.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
